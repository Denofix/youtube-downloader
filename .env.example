PORT=8080
MAX_FILE_BYTES=536870912
MAX_STORAGE_BYTES=5368709120
RESULT_TTL_SECONDS=86400
JOB_TIMEOUT_SECONDS=1800
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional trusted system CAs for an owner-configured proxy; TLS validation stays enabled.
YTDLP_USE_SYSTEM_CA=0
# Optional dedicated server cookie jar; add its bind mount to compose.override.yaml first.
# COOKIE_FILE=/run/secrets/youtube-cookies.txt
